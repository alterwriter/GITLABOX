# Scan results — contain repo names, branches, people's names & emails. Never commit them.
reports/*
!reports/.gitkeep

# Private repo lists (use repos.example.txt as the template)
repos.txt
*.repos.txt

# Local config / tokens (normally in ~/.gitlabbox, this is a safety net)
.gitlabbox/
config.json
*.hdr
*.pem
*.crt

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp
